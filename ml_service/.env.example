# Configure these values in the ML service host's environment (for example, Render).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
AGMARKNET_API_KEY=your_data_gov_in_api_key
CORS_ALLOWED_ORIGINS=https://your-flutter-web-domain.example

# Optional server-to-server credential for the Node backend only.
# Never put either server key in the mobile app configuration.
ML_SERVICE_SECRET=replace_with_a_random_secret_of_at_least_16_characters
